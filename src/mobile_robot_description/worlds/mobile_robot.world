<?xml version="1.0" ?>
<!-- Copyright 2026 Muhammad Ali Sadiq (github.com/turtleshelp).
     Licensed under the Apache License 2.0, see LICENSE and NOTICE. -->
<sdf version="1.6">

  <world name="default">

    <!-- ================================= -->
    <!-- Stable physics                    -->
    <!-- ================================= -->

    <physics name="stable_physics" type="ode">

      <max_step_size>0.0005</max_step_size>
      <!-- 2000 x 0.5 ms = up to 1x real time (was 1000, capped at 0.5x).
           Same step size, so the physics is unchanged. -->
      <real_time_update_rate>2000</real_time_update_rate>

      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
        </solver>
      </ode>

    </physics>


    <!-- ================================= -->
    <!-- Scene                             -->
    <!-- ================================= -->

    <scene>

      <ambient>0.65 0.65 0.65 1</ambient>

      <background>0.85 0.85 0.85 1</background>

      <shadows>true</shadows>

    </scene>


    <!-- ================================= -->
    <!-- Lighting                          -->
    <!-- ================================= -->

    <light name="sun" type="directional">

      <cast_shadows>true</cast_shadows>

      <pose>0 0 10 0 0 0</pose>

      <diffuse>0.9 0.9 0.9 1</diffuse>

      <specular>0.3 0.3 0.3 1</specular>

      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>

      <direction>-0.5 0.1 -0.9</direction>

    </light>


    <!-- ================================= -->
    <!-- Ground                            -->
    <!-- ================================= -->

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Attribution mark on the floor (see NOTICE). Visual only, no
         collision, so it does not affect physics, the LiDAR or the map. -->
    <model name="turtleshelp_floor_mark">
      <static>true</static>
      <pose>0.6 -1.35 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box><size>2.6 0.45 0.001</size></box>
          </geometry>
          <material>
            <script>
              <uri>model://mobile_robot_description/media/materials/scripts</uri>
              <uri>model://mobile_robot_description/media/materials/textures</uri>
              <name>Turtleshelp/FloorMark</name>
            </script>
          </material>
        </visual>
      </link>
    </model>


    <!-- ================================= -->
    <!-- Navigation Arena                  -->
    <!-- 6 m x 5 m                         -->
    <!-- ================================= -->


    <!-- North wall -->

    <model name="north_wall">

      <static>true</static>

      <pose>0 2.5 0.5 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>6.0 0.10 1.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>6.0 0.10 1.0</size>
            </box>
          </geometry>

          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- South wall -->

    <model name="south_wall">

      <static>true</static>

      <pose>0 -2.5 0.5 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>6.0 0.10 1.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>6.0 0.10 1.0</size>
            </box>
          </geometry>

          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- East wall -->

    <model name="east_wall">

      <static>true</static>

      <pose>3.0 0 0.5 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.10 5.0 1.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.10 5.0 1.0</size>
            </box>
          </geometry>

          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- West wall -->

    <model name="west_wall">

      <static>true</static>

      <pose>-3.0 0 0.5 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.10 5.0 1.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.10 5.0 1.0</size>
            </box>
          </geometry>

          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- ================================= -->
    <!-- Internal obstacles                -->
    <!-- ================================= -->


    <!-- Obstacle 1 -->

    <model name="obstacle_1">

      <static>true</static>

      <pose>1.4 1.1 0.4 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.7 0.7 0.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.7 0.7 0.8</size>
            </box>
          </geometry>

          <material>
            <ambient>0.45 0.45 0.55 1</ambient>
            <diffuse>0.45 0.45 0.55 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- Obstacle 2 -->

    <model name="obstacle_2">

      <static>true</static>

      <pose>-1.5 -1.2 0.4 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.8 0.6 0.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.8 0.6 0.8</size>
            </box>
          </geometry>

          <material>
            <ambient>0.55 0.45 0.45 1</ambient>
            <diffuse>0.55 0.45 0.45 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- Obstacle 3 - long divider -->

    <model name="obstacle_3">

      <static>true</static>

      <pose>-1.3 1.25 0.35 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.2 0.25 0.7</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.2 0.25 0.7</size>
            </box>
          </geometry>

          <material>
            <ambient>0.45 0.55 0.45 1</ambient>
            <diffuse>0.45 0.55 0.45 1</diffuse>
          </material>

        </visual>

      </link>

    </model>

    <!-- ================================= -->
    <!-- PICKUP STATION                    -->
    <!-- ================================= -->

    <model name="pickup_table">
      <static>true</static>

      <!-- Pickup pedestal: 0.25 x 0.25 x 0.18 m, open east side.
           Robot approaches head-on along +x; near face at x = 2.175. -->
      <pose>2.30 -0.30 0.09 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.25 0.25 0.18</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.25 0.25 0.18</size>
            </box>
          </geometry>

          <material>
            <ambient>0.55 0.40 0.25 1</ambient>
            <diffuse>0.55 0.40 0.25 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ================================= -->
    <!-- PICKUP CUBE                       -->
    <!-- ================================= -->

    <!-- Grasp assist: attaches the cube to the gripper (link5) once it is
         between the jaws; services /grasp_assist/attach and /detach.
         See mobile_robot_description/src/grasp_assist_plugin.cpp. -->
    <plugin name="grasp_assist" filename="libgrasp_assist_plugin.so">
      <ros>
        <namespace>/grasp_assist</namespace>
      </ros>
      <robot_model>mobile_robot</robot_model>
      <gripper_link>link5</gripper_link>
      <object_model>pickup_cube</object_model>
      <grasp_point>0.126 0 0</grasp_point>
      <tolerance>0.03 0.015 0.02</tolerance>
    </plugin>

    <model name="pickup_cube">
      <static>false</static>

      <!-- 4 cm cube (the gripper opens to ~8.8 cm and closes to ~3 cm).
           Pedestal top = 0.18 m, so center z = 0.20 m. Front face 1 cm
           behind the pedestal face (x = 2.175): center x = 2.205. Close
           to the edge so the gripper palm stays in front of the pedestal. -->
      <pose>2.205 -0.30 0.20 0 0 0</pose>

      <link name="cube_link">

        <inertial>
          <mass>0.03</mass>
          <inertia>
            <ixx>0.000008</ixx>
            <iyy>0.000008</iyy>
            <izz>0.000008</izz>
          </inertia>
        </inertial>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.04 0.04 0.04</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>2.0</mu>
                <mu2>2.0</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>1000000.0</kp>
                <kd>100.0</kd>
                <max_vel>0.0</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.04 0.04 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.15 0.15 1</ambient>
            <diffuse>0.8 0.15 0.15 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ================================= -->
    <!-- DROP STATION                      -->
    <!-- ================================= -->

    <model name="drop_table">
      <static>true</static>

      <!-- Drop pedestal: 0.25 x 0.25 x 0.18 m, open west side.
           Robot approaches head-on along -x; near face at x = -2.175. -->
      <pose>-2.30 0.0 0.09 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.25 0.25 0.18</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.25 0.25 0.18</size>
            </box>
          </geometry>

          <material>
            <ambient>0.25 0.45 0.65 1</ambient>
            <diffuse>0.25 0.45 0.65 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

  </world>

</sdf>
